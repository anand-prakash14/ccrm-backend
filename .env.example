# CRM API Service — local environment template. Copy to .env and fill in real values.
# Never commit .env with real secrets.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Comma-separated list of origins allowed to call this API from a browser
# (the ccrm-frontend Vite dev server by default).
CORS_ORIGIN=http://localhost:5173

# PostgreSQL 16.x — matches docker-compose.yml service "postgres"
DATABASE_URL=postgres://ccrm:ccrm@localhost:5432/ccrm
DB_POOL_MAX=10

# Separate database for the migration integration test suite (tests/migrations)
TEST_DATABASE_URL=postgres://ccrm:ccrm@localhost:5432/ccrm_test

# Redis 7.x — matches docker-compose.yml service "redis"
REDIS_URL=redis://localhost:6379

# JWT signing secret — min 32 chars. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-real-secret-at-least-32-characters-long
JWT_EXPIRES_IN=30m

# Shared secret presented by the MCP Server (ccrm-mcp-server) via the
# X-Agent-Service-Key header — must exactly match its own AGENT_SERVICE_KEY.
# Optional: activity_log.is_agent_initiated simply never activates until
# this is set. Generate with: openssl rand -base64 24
AGENT_SERVICE_KEY=
